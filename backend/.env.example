PORT=4000
ERP_ENDPOINT_URL=http://localhost:4000/mockerp
ERP_WEBHOOK_TIMEOUT_MS=5000
ERP_MAX_RETRY_ATTEMPTS=5
# Exponential backoff: base, 2x, 4x, 8x (1m/2m/4m/8m). Set ERP_RETRY_DELAYS_MS
# (comma-separated ms) instead to use an explicit schedule.
ERP_RETRY_BASE_DELAY_MS=60000
ERP_RETRY_POLL_INTERVAL_MS=30000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
# Winston log level: error, warn, info (default), http, verbose, debug
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=metayb
