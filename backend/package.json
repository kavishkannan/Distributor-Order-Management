{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for the distributor ordering, inventory and loyalty platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migrate": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/data-source.ts -- src/migrations/Migration",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts",
    "seed": "ts-node src/seed.ts",
    "test:transitions": "ts-node src/scripts/testTransitions.ts",
    "test:concurrency": "ts-node src/scripts/testConcurrency.ts",
    "test:idempotency": "ts-node src/scripts/testIdempotency.ts",
    "test:distributor": "ts-node src/scripts/testDistributor.ts",
    "test:webhookretry": "ts-node src/scripts/testWebhookRetry.ts",
    "test:eventlog": "ts-node src/scripts/testEventLog.ts",
    "test:loyaltywindow": "ts-node src/scripts/testLoyaltyWindow.ts",
    "test:api": "ts-node src/scripts/testApi.ts"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
